{
  "name": "dsh-personalization",
  "version": "0.1.0",
  "description": "DSH 个性化设置插件：在设置页提供「个性化」卡片，直接编辑 $DSH_HOME/AGENTS.md（用户全局个性化配置），每个会话自动注入生效。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "personalization",
    "agents.md",
    "deepseek-harness"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
